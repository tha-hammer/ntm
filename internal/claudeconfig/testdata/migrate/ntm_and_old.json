{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/ntm-old agent-hook stop",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check_critical_on_stop.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
